# -------------------------------------------------------------
# 🔐 JWT Authentication Backend Environment Variables
# -------------------------------------------------------------

# Server Port
PORT=5000

# Environment (development | production | test)
NODE_ENV=development

# PostgreSQL Connection String (Direct or Pooled)
# Local: postgresql://postgres:postgres@localhost:5432/jwt_auth
# Supabase / Neon / Railway: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jwt_auth"

# JSON Web Token Secret Key (Use a high-entropy string in production, e.g., openssl rand -base64 32)
JWT_SECRET="your-256-bit-secret-key-change-this-in-production"

# JWT Expiry format: '15m', '1h', '7d'
JWT_EXPIRES_IN="1h"

# Cookie name for storing the JWT token
COOKIE_NAME="accessToken"

# Frontend Origin URL(s) for CORS (supports comma-separated origins)
# Example: http://localhost:3000,https://app.yourdomain.com
FRONTEND_URL="http://localhost:3000"

# Rate Limiting: Max login/register attempts per 15-minute window per IP
AUTH_RATE_LIMIT_MAX=20
